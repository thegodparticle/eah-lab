[15.51, "o", "\r\n"]
[15.81, "o", "  \u001b[2mExam Details\u001b[0m\r\n"]
[16.11, "o", "  Monday, March 9 . In Class\r\n"]
[16.41, "o", "  25 multiple-choice, 60 minutes, 100 points.\r\n"]
[16.81, "o", "\r\n"]
[17.01, "o", "  Respondus LockDown Browser required.\r\n"]
[17.31, "o", "  Webcam not required for this in-class exam.\r\n"]
[17.81, "o", "\r\n"]
